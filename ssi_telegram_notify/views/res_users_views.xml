<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Extend the user Preferences form to expose Telegram notification fields.
        Fields are inserted right after the built-in `notification_type` field.
    -->
    <record id="view_users_form_simple_modif_telegram" model="ir.ui.view">
        <field name="name">res.users.form.telegram.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <field name="notification_type" position="after">
                <field name="notify_via_telegram" />
                <field
                    name="telegram_chat_id"
                    attrs="{'invisible': [('notify_via_telegram', '=', False)],
                            'required':  [('notify_via_telegram', '=', True)]}"
                    placeholder="e.g. 123456789"
                />
            </field>
        </field>
    </record>

</odoo>
